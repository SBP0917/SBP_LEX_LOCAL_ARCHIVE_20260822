{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Pre-context Package Input",
  "type": "object",
  "required": [
    "package_type",
    "request_fingerprint",
    "package_version",
    "schema_version",
    "package_id",
    "skg_package_digest",
    "dtn_package_digest",
    "signals",
    "source_records",
    "source_summary",
    "freshness_valid",
    "consistency_valid",
    "digest",
    "signature",
    "timestamp",
    "issued_at",
    "transport_identity",
    "nonce"
  ],
  "properties": {
    "package_type": {"const": "external_pre_context_signal_package"},
    "package_version": {"const": "1.0"},
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "transport_identity": {"type": "string", "minLength": 1},
    "freshness_valid": {"const": true},
    "consistency_valid": {"const": true}
  },
  "additionalProperties": true
}
