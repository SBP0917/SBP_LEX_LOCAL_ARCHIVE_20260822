# SBP-LEX V1 Runtime Security
SBP_LEX_API_SECURITY_MODE=local
SBP_LEX_REQUIRE_API_TOKEN=0
SBP_LEX_API_TOKEN=
# Required: exactly 64 lowercase hexadecimal characters representing 32 random bytes.
SBP_LEX_SIGNING_SECRET=
# Required out-of-band trust anchor: base64 ML-DSA public key matching the signer.
SBP_LEX_TRUSTED_SIGNING_PUBLIC_KEY=
# Required out-of-band SHA-256 fingerprint of that public key.
SBP_LEX_EXPECTED_SIGNER_FINGERPRINT=
# Pass 9 controlled migration profile. These are operator-approved values.
SBP_LEX_PQC_MIGRATION_STATUS=MIGRATED_APPROVED
SBP_LEX_PQC_MIGRATION_APPROVAL_REFERENCE=
SBP_LEX_SIGNING_KEY_ID=
# UTC timestamps, for example 2026-08-10T00:00:00+00:00.
SBP_LEX_SIGNING_KEY_ACTIVATED_AT=
SBP_LEX_SIGNING_KEY_EXPIRES_AT=
# Comma-separated 64-hex public-key fingerprints; use the explicit NONE
# sentinel when no keys are revoked so the registry survives Windows subprocesses.
SBP_LEX_REVOKED_SIGNING_KEY_FINGERPRINTS=NONE
# Optional comma-separated archive-read approvals. It never enables runtime V2.
SBP_LEX_APPROVED_LEGACY_ARCHIVE_POLICIES=
SBP_LEX_MAX_API_BODY_BYTES=1000000
SBP_LEX_MAX_REPLAY_COUNT=5
SBP_LEX_INTEGRITY_STORE=runtime_artifacts/integrity_store.jsonl
