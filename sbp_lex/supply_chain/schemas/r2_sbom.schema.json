{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbp-lex:desktop-v1:r2:sbom:v1",
  "title": "Desktop V1 R2 deterministic software bill of materials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sbom_version",
    "desktop_scope",
    "dependency_count",
    "direct_dependency_count",
    "transitive_dependency_count",
    "dependencies",
    "dependency_digest"
  ],
  "properties": {
    "sbom_version": {"const": "R2_DESKTOP_V1_SBOM_V1"},
    "desktop_scope": {
      "const": "SBP_LEX_DUAL_V6_DESKTOP_V1_LOCAL_PRIVATE_SINGLE_HOST_NO_NODE"
    },
    "dependency_count": {"type": "integer", "minimum": 1},
    "direct_dependency_count": {"type": "integer", "minimum": 1},
    "transitive_dependency_count": {"type": "integer", "minimum": 0},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "dependency_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "normalized_name",
        "version",
        "relationship",
        "declared_requirement",
        "required_by",
        "source",
        "licence",
        "distribution_sha256",
        "distribution_file_count",
        "distribution_size_bytes",
        "approval_status",
        "integrity_status"
      ],
      "properties": {
        "package": {"$ref": "#/$defs/nonempty"},
        "normalized_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {"$ref": "#/$defs/nonempty"},
        "relationship": {"enum": ["DIRECT", "TRANSITIVE"]},
        "declared_requirement": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty"},
            {"type": "null"}
          ]
        },
        "required_by": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "source": {"$ref": "#/$defs/nonempty"},
        "licence": {"$ref": "#/$defs/nonempty"},
        "distribution_sha256": {"$ref": "#/$defs/sha256"},
        "distribution_file_count": {"type": "integer", "minimum": 1},
        "distribution_size_bytes": {"type": "integer", "minimum": 1},
        "approval_status": {"const": "APPROVED"},
        "integrity_status": {"const": "VERIFIED"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"relationship": {"const": "DIRECT"}}
          },
          "then": {
            "properties": {
              "declared_requirement": {"$ref": "#/$defs/nonempty"}
            }
          },
          "else": {
            "properties": {
              "declared_requirement": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
