{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbp-lex:desktop-v1:h7:execution-capability:v1",
  "title": "Desktop V1 H7 Single-Use Execution Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_version", "capability_id", "request_id", "request_fingerprint",
    "traversal_authority_digest", "issuance_authority_key", "eie_identifier", "eie_digest",
    "canonical_state_hash", "pipeline_mode", "pipeline_a_result_digest",
    "pipeline_b_result_digest", "convergence_result", "procedural_truth_token",
    "classification_token", "licensing_token", "governance_token", "grc_token",
    "domain_token", "aurion_result", "target_identity", "target_type",
    "operation_identity", "canonical_parameter_digest", "constraint_digest",
    "execution_specification_id", "execution_specification_digest",
    "constraint_snapshot", "issued_at", "not_before", "expires_at",
    "reservation_timeout_seconds", "execution_start_deadline", "maximum_execution_seconds",
    "completion_report_deadline", "maximum_attempts", "consumption_state",
    "cancellation_state", "safe_cancellation_supported", "issuer_identity",
    "runtime_identity", "approved_baseline_identifier", "measurement_digest",
    "execution_adapter_identity", "execution_consumer_identity", "audit_lineage_identifier", "capability_digest",
    "integrity_binding"
  ],
  "properties": {
    "capability_version": {"const": "H7_EXECUTION_CAPABILITY_V1"},
    "capability_id": {"$ref": "#/$defs/digest"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_fingerprint": {"$ref": "#/$defs/digest"},
    "traversal_authority_digest": {"$ref": "#/$defs/digest"},
    "issuance_authority_key": {"$ref": "#/$defs/digest"},
    "eie_identifier": {"type": "string", "minLength": 1},
    "eie_digest": {"$ref": "#/$defs/digest"},
    "canonical_state_hash": {"$ref": "#/$defs/digest"},
    "pipeline_mode": {"enum": ["MODE_1_FULL_MIRRORED", "MODE_2_SPLIT_VALIDATOR", "MODE_3_SINGLE_CONSTRAINED"]},
    "pipeline_a_result_digest": {"$ref": "#/$defs/digest"},
    "pipeline_b_result_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "convergence_result": {"$ref": "#/$defs/digest"},
    "procedural_truth_token": {"$ref": "#/$defs/digest"},
    "classification_token": {"$ref": "#/$defs/digest"},
    "licensing_token": {"$ref": "#/$defs/digest"},
    "governance_token": {"$ref": "#/$defs/digest"},
    "grc_token": {"$ref": "#/$defs/digest"},
    "domain_token": {"$ref": "#/$defs/digest"},
    "aurion_result": {"$ref": "#/$defs/digest"},
    "target_identity": {"$ref": "#/$defs/identity"},
    "target_type": {"$ref": "#/$defs/identity"},
    "operation_identity": {"$ref": "#/$defs/identity"},
    "canonical_parameter_digest": {"$ref": "#/$defs/digest"},
    "execution_specification_id": {"$ref": "#/$defs/identity"},
    "execution_specification_digest": {"$ref": "#/$defs/digest"},
    "constraint_digest": {"$ref": "#/$defs/digest"},
    "constraint_snapshot": {"type": "object", "minProperties": 1},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "not_before": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "reservation_timeout_seconds": {"type": "integer", "minimum": 1},
    "execution_start_deadline": {"$ref": "#/$defs/timestamp"},
    "maximum_execution_seconds": {"type": "integer", "minimum": 1},
    "completion_report_deadline": {"$ref": "#/$defs/timestamp"},
    "maximum_attempts": {"const": 1},
    "consumption_state": {"const": "UNCONSUMED"},
    "cancellation_state": {"const": "NOT_CANCELLED"},
    "safe_cancellation_supported": {"type": "boolean"},
    "issuer_identity": {"const": "SBP_LEX_DESKTOP_V1_EXECUTION_INTEGRITY"},
    "runtime_identity": {"type": "string", "minLength": 1},
    "approved_baseline_identifier": {"type": "string", "minLength": 1},
    "measurement_digest": {"$ref": "#/$defs/digest"},
    "execution_adapter_identity": {"$ref": "#/$defs/identity"},
    "execution_consumer_identity": {"const": "SBP_LEX_DESKTOP_V1_LOCAL_EXECUTION_SERVICE"},
    "audit_lineage_identifier": {"$ref": "#/$defs/digest"},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "integrity_binding": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
