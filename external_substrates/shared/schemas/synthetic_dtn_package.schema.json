{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbp-lex:desktop-v1:synthetic-dtn-package:v1",
  "title": "Desktop V1 deterministic synthetic DTN package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_type",
    "schema_version",
    "package_reference",
    "request_fingerprint",
    "eie_digest",
    "skg_constraint_digest",
    "authority_reference",
    "jurisdiction",
    "operational_context",
    "environmental_context",
    "feasibility_constraints",
    "dependencies",
    "pathway_viability",
    "consequence_risk_context",
    "provenance",
    "issued_at",
    "freshness_seconds",
    "nonce",
    "signature_mode",
    "digest",
    "signature"
  ],
  "properties": {
    "package_type": {"const": "synthetic_dtn_package"},
    "schema_version": {"const": "desktop-v1.synthetic.dtn.v1"},
    "package_reference": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "minLength": 1},
    "eie_digest": {"type": "string", "minLength": 1},
    "skg_constraint_digest": {"type": "string", "minLength": 1},
    "authority_reference": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "object"},
    "operational_context": {"type": "object"},
    "environmental_context": {"type": "object"},
    "feasibility_constraints": {"type": "array", "minItems": 1},
    "dependencies": {"type": "array"},
    "pathway_viability": {"type": "object"},
    "consequence_risk_context": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "freshness_seconds": {"type": "integer", "minimum": 0},
    "nonce": {"type": "string", "minLength": 1},
    "signature_mode": {"const": "CONTROLLED_LOCAL_HMAC_SHA256_V1"},
    "digest": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1}
  }
}
