{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop V1 External Source Trust Record",
  "type": "object",
  "required": [
    "trust_record_version", "source_id", "substrate_type", "key_id", "key_version",
    "algorithm", "public_verification_material", "allowed_package_types",
    "allowed_schema_versions", "not_before", "expires_at", "status", "revoked_at",
    "revocation_reason", "replacement_key_id", "previous_record_hash", "record_hash",
    "integrity_binding"
  ],
  "properties": {
    "trust_record_version": {"const": "H6H_EXTERNAL_SOURCE_TRUST_RECORD_V1"},
    "source_id": {"type": "string", "minLength": 1},
    "substrate_type": {"enum": ["SKG", "DTN"]},
    "key_id": {"type": "string", "minLength": 1},
    "key_version": {"type": "integer", "minimum": 1},
    "algorithm": {"const": "ML-DSA"},
    "public_verification_material": {"type": "string", "minLength": 1},
    "allowed_package_types": {"type": "array", "minItems": 1, "uniqueItems": true},
    "allowed_schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PENDING", "ACTIVE", "ROTATING", "SUSPENDED", "REVOKED", "EXPIRED", "RETIRED"]},
    "revoked_at": {"type": ["string", "null"]},
    "revocation_reason": {"type": ["string", "null"]},
    "replacement_key_id": {"type": ["string", "null"]},
    "previous_record_hash": {"type": "string", "minLength": 1},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "integrity_binding": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
