{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalSKGSignalPackage",
  "type": "object",
  "required": [
    "package_type", "package_version", "schema_version", "package_id",
    "request_fingerprint", "signals", "source_records", "source_summary",
    "skg_truth_foundation_metadata", "freshness_valid", "consistency_valid",
    "timestamp", "issued_at", "transport_identity", "digest", "signature"
  ],
  "properties": {
    "package_type": {"const": "external_skg_signal_package"},
    "package_version": {"const": "1.0"},
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_fingerprint": {"type": "string", "minLength": 1},
    "signals": {"type": "object", "minProperties": 1},
    "source_records": {"type": "array", "minItems": 1},
    "source_summary": {"type": "object"},
    "skg_truth_foundation_metadata": {"type": "object"},
    "freshness_valid": {"const": true},
    "consistency_valid": {"const": true},
    "timestamp": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"},
    "transport_identity": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
