# Canonical repository text representation.
# Measured-startup hashes raw bytes, so checkout line endings must not depend on
# a user's core.autocrlf setting.
* text=auto eol=lf

# Native Windows command launchers retain conventional CRLF checkout bytes.
*.bat text eol=crlf
*.cmd text eol=crlf

# Windows-generated, hash-bound evidence is serialized as CRLF. Preserve that
# representation so committing and checking out the evidence cannot invalidate
# its embedded file hashes and signatures.
outputs/local_*.json text eol=crlf
outputs/adversarial_*.json text eol=crlf
outputs/release_integrity_bundle/** text eol=crlf
outputs/university_validation_dossier/** text eol=crlf
validation_package/evidence/outputs/local_*.json text eol=crlf
validation_package/evidence/outputs/adversarial_*.json text eol=crlf
validation_package/evidence/outputs/release_integrity_bundle/** text eol=crlf

# Binary assets must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.whl binary
*.exe binary
*.dll binary
*.pyd binary
